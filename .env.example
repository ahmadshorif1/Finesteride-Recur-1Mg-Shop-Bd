# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this Customer Panel is hosted.
APP_URL="MY_APP_URL"

# SHARED FIREBASE PROJECT CONFIGURATION (Customer Panel <-> Admin Panel)
# Connect to the exact same Firebase project as your Admin Panel.
# In AI Studio, firebase-applet-config.json is automatically used when these are left empty.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# OPTIONAL BANGLADESH PAYMENT GATEWAY SERVER CREDENTIALS (Backend Only - Never expose VITE_ prefix)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"

# GATEWAY_KEY_PAIR: Optional merchant API key pair for secure bKash / Nagad / SSLCommerz gateway integration
GATEWAY_KEY_PAIR=""
