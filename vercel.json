{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://admin-panel-5ecd8.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://admin-panel-5ecd8.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/((?!api/|__/|assets/|images/|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
